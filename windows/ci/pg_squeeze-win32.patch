@@ -786,7 +785,20 @@ squeeze_initialize_bgworker(BackgroundWorker *worker,
 
 	if (con_init != NULL)
 	{
+#ifdef WIN32
+		WorkerConInitWin32 con;
+
+		StaticAssertStmt(sizeof(WorkerConInitWin32) <= BGW_EXTRALEN,
+						 "WorkerConInitWin32 is too big");
+		memset(&con, 0, sizeof(con));
+		if (strlcpy(con.dbname, con_init->dbname, sizeof(con.dbname)) >= sizeof(con.dbname) ||
