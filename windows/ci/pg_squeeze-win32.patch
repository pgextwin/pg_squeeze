+			elog(ERROR, "database or role name is too long for squeeze worker");
+		worker->bgw_main_arg = (Datum) SQUEEZE_WIN32_BGWORKER_AUTOSTART;
+		memcpy(worker->bgw_extra, &con, sizeof(con));
+#else
