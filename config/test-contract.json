      "evidence": [
        "sql-result"
      ]
    },
    {
      "id": "autostart-and-stop-scheduler",
      "description": "Restarts the same cluster with scheduler autostart enabled, observes the worker in pg_stat_activity, then calls squeeze.stop_worker() and waits for the worker to exit.",
